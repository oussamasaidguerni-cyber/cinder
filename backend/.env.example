# CINDER backend environment variables (copy to .env and fill in)
# Never commit real .env files.

# AI provider. Precedence: NVIDIA (build.nvidia.com NIM) -> Gemini -> fallback/demo.
# Set either key; leave both empty for automatic fallback/demo mode.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server
APP_BIND=127.0.0.1
APP_PORT=8000

# Data
APP_DB_PATH=./data/cinder.db