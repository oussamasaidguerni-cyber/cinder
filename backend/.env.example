# CINDER backend environment variables (copy to .env and fill in)
# Never commit real .env files.

# AI provider. Leave GEMINI_API_KEY empty -> automatic fallback/demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server
APP_BIND=127.0.0.1
APP_PORT=8000

# Data
APP_DB_PATH=./data/cinder.db